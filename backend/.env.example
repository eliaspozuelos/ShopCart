NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# SQL Server host or IP. For a named instance, configure its TCP port explicitly.
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=ShopCart
SQL_USER=replace-with-your-sql-user
SQL_PASSWORD=replace-with-your-local-sql-password
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

JWT_ACCESS_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax